<?xml version="1.0" encoding="UTF-8"?>

<!-- this is the maven configuration file for the PC+ Spring Boot project -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <!-- tells Maven which pom model version this file uses -->
  <modelVersion>4.0.0</modelVersion>

  <!-- Spring Boot parent project that provides default dependency and plugin versions -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.3</version>
    <relativePath/>
  </parent>

  <!-- basic project information used by Maven -->
  <groupId>com.pcplus</groupId>
  <artifactId>pcplus-mvc-app</artifactId>
  <version>1.0.0</version>
  <name>PC+ MVC App</name>
  <description>System Increment 1 MVC version of the PC+ project</description>

  <!-- sets the Java version used to compile and run the project -->
  <properties>
    <java.version>21</java.version>
  </properties>

  <!-- dependencies are the external libraries that the project needs -->
  <dependencies>

    <!-- this starter serves the mvc pages and the api controllers -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- this starter gives us freemarker views just like assignment 3 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-freemarker</artifactId>
    </dependency>

    <!-- this starter handles jpa and database persistence -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- this starter keeps the existing jwt security setup working for the api -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- this starter supports request validation for api and mvc form inputs -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- this driver connects spring boot to postgres and neon -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- these dependencies support jwt auth for the existing api -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>0.12.5</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>0.12.5</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>0.12.5</version>
      <scope>runtime</scope>
    </dependency>

    <!-- these dependencies support testing if you want to add tests later -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <!-- build section controls how Maven packages and runs the project -->
  <build>
    <plugins>

      <!-- Spring Boot plugin allows the app to run with mvn spring-boot:run and package as a boot app -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

    </plugins>
  </build>

</project>